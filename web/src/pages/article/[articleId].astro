---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight, Bookmark, MessageSquare, Plus, Check } from 'lucide-react';
import { ARTICLES, SPEAKERS } from '../../constants';

export function getStaticPaths() {
  return ARTICLES.map(article => ({
    params: { articleId: article.id }
  }));
}

const { articleId } = Astro.params;
const article = ARTICLES.find(a => a.id === articleId);

if (!article) {
  return Astro.redirect('/404');
}

const contributors = SPEAKERS.filter(s => article.contributorIds.includes(s.id));

// Get neighbor articles
const trackArticles = ARTICLES.filter(a => a.track === article.track).sort((a,b) => a.order - b.order);
const idx = trackArticles.findIndex(a => a.id === article.id);
const prevArticle = idx > 0 ? trackArticles[idx - 1] : undefined;
const nextArticle = idx < trackArticles.length - 1 ? trackArticles[idx + 1] : undefined;

const trackUrl = `/track/${article.track.toLowerCase()}`;
---

<BaseLayout title={`${article.title} - Horizon 2025`}>
  <div class="w-full min-h-screen bg-paper pb-20 animate-in fade-in duration-300">

    <div class="max-w-4xl mx-auto bg-[#fdfdfc] border-x border-void min-h-screen shadow-lg relative">

      <!-- Toolbar -->
      <div class="sticky top-0 z-40 bg-paper border-b border-void p-3 flex justify-between items-center print:hidden border-x border-void mx-[-1px]">
        <a
          href={trackUrl}
          class="flex items-center gap-2 text-void hover:text-rand-blue transition-colors font-mono font-bold text-xs uppercase tracking-widest px-2"
        >
          <ArrowLeft className="w-4 h-4" />
          {article.track} Index
        </a>

        <div class="flex items-center gap-4 px-2">
          <button
            id="chat-button"
            class="flex items-center gap-2 px-3 py-1 border border-void hover:bg-void hover:text-white transition-colors text-[10px] font-mono font-bold uppercase"
          >
            <MessageSquare className="w-3 h-3" />
            Query Data
          </button>
          <button
            id="save-button"
            data-article-id={article.id}
            data-article-title={article.title}
            class="flex items-center gap-2 text-xs font-mono uppercase text-gray-500 hover:text-void"
          >
            <Bookmark className="w-4 h-4" />
            <span class="save-text">File</span>
          </button>
        </div>
      </div>

      <!-- Page Content -->
      <div class="px-8 md:px-24 py-16">

        <!-- Header Block -->
        <div class="mb-12">
          <div class="flex justify-between items-end border-b-4 border-void pb-4 mb-8">
            <div>
              <span class="font-mono text-xs uppercase tracking-widest block mb-2 text-gray-500">
                {article.track} // SECTION 0{article.order}
              </span>
              <h1 class="text-3xl md:text-5xl font-sans font-black text-void leading-none uppercase">
                {article.title}
              </h1>
            </div>
          </div>

          <p class="text-lg font-mono leading-relaxed text-void mb-8 max-w-2xl">
            <span class="font-bold mr-2">ABSTRACT:</span>
            {article.subtitle}
          </p>
        </div>

        <!-- Figure -->
        <div class="mb-12 border border-void p-1 bg-white">
          <div class="aspect-[2/1] relative overflow-hidden halftone grayscale contrast-125">
            <img src={article.imageUrl} alt={article.title} class="w-full h-full object-cover" />
          </div>
          <div class="p-2 border-t border-void flex gap-4 items-start">
            <span class="font-mono text-xs font-bold whitespace-nowrap">FIG. {article.order}.1</span>
            <p class="font-mono text-[10px] uppercase text-gray-600 leading-tight">
              Visual documentation.
            </p>
          </div>
        </div>

        <!-- Body Text -->
        <article class="prose prose-p:font-mono prose-headings:font-sans prose-headings:font-bold prose-headings:uppercase max-w-none text-justify text-sm md:text-base border-b border-dashed border-gray-400 pb-12">
          {article.content.split('\n').map((paragraph) => {
            const p = paragraph.trim();
            if (!p) return null;
            if (p.startsWith('###')) {
              return (
                <div class="mt-12 mb-4">
                  <h3 class="text-lg font-sans font-black text-void flex items-center gap-2">
                    <span class="w-4 h-4 bg-void"></span>
                    {p.replace('###', '').trim()}
                  </h3>
                </div>
              );
            }
            if (p.startsWith('>')) {
              return (
                <div class="pl-8 border-l-2 border-void py-2 my-8">
                  <p class="font-sans font-bold italic text-lg leading-tight text-void">
                    "{p.replace('>', '').trim()}"
                  </p>
                </div>
              );
            }
            return (
              <p class="mb-6 leading-relaxed font-mono text-gray-800">
                {p}
              </p>
            );
          })}
        </article>

        <!-- Contributors Section -->
        <div class="mt-12">
          <h4 class="font-sans font-bold text-sm uppercase mb-6 flex items-center gap-2">
            <span class="w-2 h-2 bg-alert-red rounded-full"></span>
            Contributing Researchers (Access Personnel Files)
          </h4>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {contributors.map(speaker => (
              <a
                href={`/speakers/${speaker.id}`}
                class="border border-gray-300 bg-white p-4 flex gap-4 hover:border-void hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] transition-all cursor-pointer group"
              >
                <img
                  src={speaker.imageUrl}
                  alt={speaker.name}
                  class="w-16 h-16 object-cover border border-gray-200 bell-labs-photo"
                />
                <div class="flex-1 flex flex-col justify-between">
                  <div>
                    <h5 class="font-sans font-bold text-sm uppercase group-hover:underline decoration-1 underline-offset-4">{speaker.name}</h5>
                    <p class="font-mono text-[10px] text-gray-500 uppercase">{speaker.company}</p>
                  </div>
                  <div class="flex justify-between items-center mt-2">
                    <span class="text-[9px] font-mono uppercase text-rand-blue font-bold">View Dossier &rarr;</span>
                    <button
                      class="save-speaker-btn w-6 h-6 flex items-center justify-center border border-gray-200 hover:bg-gray-100 rounded-sm"
                      data-speaker-id={speaker.id}
                      data-speaker-name={speaker.name}
                      onclick="event.preventDefault(); event.stopPropagation();"
                    >
                      <Plus className="w-3 h-3 text-gray-400 save-icon" />
                      <Check className="w-3 h-3 text-alert-red saved-icon hidden" />
                    </button>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Bottom Navigation -->
        <div class="mt-20 flex justify-between items-center pt-8 border-t-4 border-void">
          {prevArticle ? (
            <a href={`/article/${prevArticle.id}`} class="text-left group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">Previous Section</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-rand-blue">
                <ArrowLeft className="w-4 h-4" /> {prevArticle.title}
              </div>
            </a>
          ) : (
            <div></div>
          )}

          {nextArticle ? (
            <a href={`/article/${nextArticle.id}`} class="text-right group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">Proceed to Section 0{nextArticle.order}</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-rand-blue">
                {nextArticle.title} <ArrowRight className="w-4 h-4" />
              </div>
            </a>
          ) : (
            <a href={trackUrl} class="text-right group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">End of Track</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-alert-red">
                Return to Index <ArrowRight className="w-4 h-4" />
              </div>
            </a>
          )}
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Save/unsave article functionality
  function updateSaveButton() {
    const button = document.getElementById('save-button');
    if (!button) return;

    const articleId = button.dataset.articleId;
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const isSaved = saved.some((item: any) => item.id === articleId);

    const textEl = button.querySelector('.save-text');
    if (textEl) {
      textEl.textContent = isSaved ? 'Filed' : 'File';
    }
    button.classList.toggle('text-alert-red', isSaved);
    button.classList.toggle('font-bold', isSaved);
    button.classList.toggle('text-gray-500', !isSaved);
  }

  document.getElementById('save-button')?.addEventListener('click', () => {
    const button = document.getElementById('save-button');
    if (!button) return;

    const articleId = button.dataset.articleId;
    const articleTitle = button.dataset.articleTitle;

    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const existingIndex = saved.findIndex((item: any) => item.id === articleId);

    if (existingIndex >= 0) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        id: articleId,
        type: 'article',
        title: articleTitle,
        timestamp: Date.now()
      });
    }

    localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
    updateSaveButton();
    window.dispatchEvent(new Event('saved-items-updated'));
  });

  // Chat button
  document.getElementById('chat-button')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-chat'));
  });

  // Save speaker functionality
  function updateSpeakerButtons() {
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    document.querySelectorAll('.save-speaker-btn').forEach(btn => {
      const speakerId = (btn as HTMLElement).dataset.speakerId;
      const isSaved = saved.some((item: any) => item.id === speakerId);

      const saveIcon = btn.querySelector('.save-icon');
      const savedIcon = btn.querySelector('.saved-icon');

      if (isSaved) {
        saveIcon?.classList.add('hidden');
        savedIcon?.classList.remove('hidden');
      } else {
        saveIcon?.classList.remove('hidden');
        savedIcon?.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll('.save-speaker-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const speakerId = (btn as HTMLElement).dataset.speakerId;
      const speakerName = (btn as HTMLElement).dataset.speakerName;

      const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
      const existingIndex = saved.findIndex((item: any) => item.id === speakerId);

      if (existingIndex >= 0) {
        saved.splice(existingIndex, 1);
      } else {
        saved.push({
          id: speakerId,
          type: 'speaker',
          title: speakerName,
          timestamp: Date.now()
        });
      }

      localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
      updateSpeakerButtons();
      window.dispatchEvent(new Event('saved-items-updated'));
    });
  });

  updateSaveButton();
  updateSpeakerButtons();
</script>
