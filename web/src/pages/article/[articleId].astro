---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight, Bookmark, MessageSquare, Plus, Check } from 'lucide-react';
import { getCollection, getEntry, render } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  return allArticles.map(article => ({
    params: { articleId: article.id }
  }));
}

const { articleId } = Astro.params;
const articleEntry = await getEntry('articles', articleId);

if (!articleEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(articleEntry);

// Determine track from file path
const isLeadership = articleId.includes('trust-role') ||
                     articleId.includes('context-memory') ||
                     articleId.includes('sdlc-evolution') ||
                     articleId.includes('roi-reality') ||
                     articleId.includes('proactive-vs') ||
                     articleId.includes('economics-ai');

const track = isLeadership ? 'LEADERSHIP' : 'ENGINEERING';

const article = {
  id: articleEntry.id,
  title: articleEntry.data.title,
  subtitle: articleEntry.data.key_insights?.[0] || '',
  track: track,
  order: articleEntry.data.order,
  author: articleEntry.data.key_speakers?.[0] || 'Various Speakers',
  readTime: '15 min read',
  imageUrl: articleEntry.data.header_image || 'https://picsum.photos/seed/ai_art/1200/600'
};

// Get all articles in same track for navigation
const allArticles = await getCollection('articles');
const trackArticles = allArticles
  .map((a: any) => {
    const isLeadershipTrack = a.id.includes('trust-role') ||
                              a.id.includes('context-memory') ||
                              a.id.includes('sdlc-evolution') ||
                              a.id.includes('roi-reality') ||
                              a.id.includes('proactive-vs') ||
                              a.id.includes('economics-ai');
    return {
      id: a.id,
      title: a.data.title,
      order: a.data.order,
      track: isLeadershipTrack ? 'LEADERSHIP' : 'ENGINEERING'
    };
  })
  .filter((a: any) => a.track === track)
  .sort((a: any, b: any) => a.order - b.order);

const idx = trackArticles.findIndex((a: any) => a.id === articleId);
const prevArticle = idx > 0 ? trackArticles[idx - 1] : undefined;
const nextArticle = idx < trackArticles.length - 1 ? trackArticles[idx + 1] : undefined;

const trackUrl = `${base}/track/${track.toLowerCase()}`;

// Get speakers who contributed to this article with their session info
const contributors: any[] = [];
if (articleEntry.data.key_speakers && Array.isArray(articleEntry.data.key_speakers)) {
  const speakers = await getCollection('speakers');

  for (const speakerName of articleEntry.data.key_speakers) {
    // Strip company suffix like " (Netflix)" from theme speaker names
    const cleanName = speakerName.replace(/\s*\([^)]+\)\s*$/, '').trim();
    const speaker = speakers.find((s: any) => s.data.name === cleanName);

    if (speaker) {
      // Clean session text by removing markdown link syntax
      let sessionText = speaker.data.session || '';
      if (sessionText) {
        // Remove markdown links: "text ([link](url))" becomes "text"
        sessionText = sessionText.replace(/\s*\(\[.*?\]\(.*?\)\)\s*$/, '').trim();
      }

      // Clean company text by removing markdown link syntax
      let companyText = speaker.data.company || '';
      if (companyText) {
        // Remove markdown links from company field
        companyText = companyText.replace(/\s*\(\[.*?\]\(.*?\)\)\s*$/, '').trim();
      }

      contributors.push({
        id: speaker.id,
        name: speaker.data.name,
        company: companyText,
        role: speaker.data.role,
        session: sessionText,
        session_file: speaker.data.session_file,
        imageUrl: `/photos/${speaker.id}.jpg`
      });
    }
  }
}
---

<BaseLayout title={`${article.title} - AI Engineering Code Summit`}>
  <div class="w-full min-h-screen bg-paper pb-20 animate-in fade-in duration-300">

    <div class="max-w-4xl mx-auto bg-[#fdfdfc] border-x border-void min-h-screen shadow-lg relative">

      <!-- Toolbar -->
      <div class="sticky top-0 z-40 bg-paper border-b border-void p-3 flex justify-between items-center print:hidden border-x border-void mx-[-1px]">
        <a
          href={trackUrl}
          class="flex items-center gap-2 text-void hover:text-rand-blue transition-colors font-mono font-bold text-xs uppercase tracking-widest px-2"
        >
          <ArrowLeft className="w-4 h-4" />
          {article.track} Index
        </a>

        <div class="flex items-center gap-4 px-2">
          <button
            id="chat-button"
            class="flex items-center gap-2 px-3 py-1 border border-void hover:bg-void hover:text-white transition-colors text-[10px] font-mono font-bold uppercase"
          >
            <MessageSquare className="w-3 h-3" />
            Query Data
          </button>
          <button
            id="save-button"
            data-article-id={article.id}
            data-article-title={article.title}
            class="flex items-center gap-2 text-xs font-mono uppercase text-gray-500 hover:text-void"
          >
            <Bookmark className="w-4 h-4" />
            <span class="save-text">File</span>
          </button>
        </div>
      </div>

      <!-- Page Content -->
      <div class="px-8 md:px-24 py-16">

        <!-- Header Block -->
        <div class="mb-12">
          <div class="relative border-b-4 border-void pb-4 mb-8">
            {articleEntry.data.edited && (
              <img
                src={`${base}/images/human-approved-stamp.png`}
                alt="Human Approved"
                class="absolute -right-4 md:-right-12 top-0 w-32 md:w-48 h-auto rotate-12 opacity-60"
              />
            )}
            <div class="relative z-10">
              <span class="font-mono text-xs uppercase tracking-widest block mb-2 text-gray-500">
                {article.track} // SECTION 0{article.order}
              </span>
              <h1 class="text-3xl md:text-5xl font-sans font-black text-void leading-none uppercase mb-4">
                {article.title}
              </h1>
            </div>
          </div>

          <p class="text-base md:text-lg font-mono leading-relaxed text-void mb-8 max-w-2xl">
            <span class="font-bold mr-2">ABSTRACT:</span>
            {article.subtitle}
          </p>
        </div>

        <!-- Figure -->
        <div class="mb-12 border border-void p-1 bg-white">
          <div class={`aspect-[2/1] relative overflow-hidden ${articleEntry.data.header_image ? '' : 'halftone grayscale contrast-125'}`}>
            <img src={article.imageUrl} alt={article.title} class="w-full h-full object-cover" />
          </div>
          <div class="p-2 border-t border-void flex gap-4 items-start">
            <span class="font-mono text-xs font-bold whitespace-nowrap">FIG. {article.order}.1</span>
            <p class="font-mono text-[10px] uppercase text-gray-600 leading-tight">
              Visual documentation.
            </p>
          </div>
        </div>

        <!-- Contributors Section -->
        <div class="mb-12">
          <h4 class="font-sans font-bold text-base uppercase mb-2 flex items-center gap-2">
            <span class="w-2 h-2 bg-alert-red rounded-full"></span>
            Featured Experts
          </h4>
          <p class="font-mono text-sm text-gray-600 mb-6">
            Learn more about the people behind these insights
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {contributors.map(speaker => (
              <a
                href={`${base}/speakers/${speaker.id}`}
                class="border border-gray-300 bg-white p-5 hover:border-void hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] transition-all cursor-pointer group"
              >
                <div class="flex gap-4 mb-3">
                  <img
                    src={speaker.imageUrl}
                    alt={speaker.name}
                    class="w-20 h-20 object-cover border-2 border-gray-200 grayscale contrast-125"
                  />
                  <div class="flex-1">
                    <h5 class="font-sans font-bold text-base group-hover:text-rand-blue transition-colors mb-1">{speaker.name}</h5>
                    <p class="font-mono text-xs text-gray-600 mb-0.5">{speaker.role}</p>
                    <p class="font-mono text-xs text-gray-500">{speaker.company}</p>
                  </div>
                </div>
                {speaker.session && (
                  <div class="pt-3 border-t border-gray-200">
                    <p class="font-mono text-[10px] text-gray-400 uppercase mb-1">Conference Session</p>
                    <p class="font-mono text-sm text-void leading-snug">{speaker.session}</p>
                  </div>
                )}
                <div class="mt-3 flex justify-between items-center">
                  <span class="text-xs font-mono uppercase text-rand-blue font-bold group-hover:underline">View Profile &rarr;</span>
                  <button
                    class="save-speaker-btn w-7 h-7 flex items-center justify-center border border-gray-300 hover:bg-gray-100 rounded-sm transition-colors"
                    data-speaker-id={speaker.id}
                    data-speaker-name={speaker.name}
                    onclick="event.preventDefault(); event.stopPropagation();"
                  >
                    <Plus className="w-4 h-4 text-gray-400 save-icon" />
                    <Check className="w-4 h-4 text-alert-red saved-icon hidden" />
                  </button>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Body Text -->
        <article class="prose prose-lg max-w-none prose-headings:font-sans prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-4 prose-p:font-mono prose-p:text-lg prose-p:leading-8 prose-p:my-6 prose-ul:my-6 prose-li:my-3 prose-li:font-mono prose-li:text-lg prose-li:leading-8 prose-blockquote:border-l-4 prose-blockquote:border-rand-blue prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:my-10 prose-blockquote:font-sans prose-blockquote:text-xl prose-blockquote:leading-9 prose-blockquote:font-bold prose-blockquote:not-italic prose-a:text-rand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-img:border-2 prose-img:border-void prose-img:shadow-lg prose-img:my-10 border-b border-dashed border-gray-400 pb-12">
          <Content />
        </article>

        <!-- Bottom Navigation -->
        <div class="mt-20 flex justify-between items-center pt-8 border-t-4 border-void">
          {prevArticle ? (
            <a href={`${base}/article/${prevArticle.id}`} class="text-left group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">Previous Section</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-rand-blue">
                <ArrowLeft className="w-4 h-4" /> {prevArticle.title}
              </div>
            </a>
          ) : (
            <div></div>
          )}

          {nextArticle ? (
            <a href={`${base}/article/${nextArticle.id}`} class="text-right group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">Proceed to Section 0{nextArticle.order}</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-rand-blue">
                {nextArticle.title} <ArrowRight className="w-4 h-4" />
              </div>
            </a>
          ) : (
            <a href={trackUrl} class="text-right group">
              <span class="block font-mono text-[10px] text-gray-400 uppercase mb-1">End of Track</span>
              <div class="flex items-center gap-2 font-sans font-bold uppercase text-void group-hover:text-alert-red">
                Return to Index <ArrowRight className="w-4 h-4" />
              </div>
            </a>
          )}
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Save/unsave article functionality
  function updateSaveButton() {
    const button = document.getElementById('save-button');
    if (!button) return;

    const articleId = button.dataset.articleId;
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const isSaved = saved.some((item: any) => item.id === articleId);

    const textEl = button.querySelector('.save-text');
    if (textEl) {
      textEl.textContent = isSaved ? 'Filed' : 'File';
    }
    button.classList.toggle('text-alert-red', isSaved);
    button.classList.toggle('font-bold', isSaved);
    button.classList.toggle('text-gray-500', !isSaved);
  }

  document.getElementById('save-button')?.addEventListener('click', () => {
    const button = document.getElementById('save-button');
    if (!button) return;

    const articleId = button.dataset.articleId;
    const articleTitle = button.dataset.articleTitle;

    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const existingIndex = saved.findIndex((item: any) => item.id === articleId);

    if (existingIndex >= 0) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        id: articleId,
        type: 'article',
        title: articleTitle,
        timestamp: Date.now()
      });
    }

    localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
    updateSaveButton();
    window.dispatchEvent(new Event('saved-items-updated'));
  });

  // Chat button
  document.getElementById('chat-button')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-chat'));
  });

  // Save speaker functionality
  function updateSpeakerButtons() {
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    document.querySelectorAll('.save-speaker-btn').forEach(btn => {
      const speakerId = (btn as HTMLElement).dataset.speakerId;
      const isSaved = saved.some((item: any) => item.id === speakerId);

      const saveIcon = btn.querySelector('.save-icon');
      const savedIcon = btn.querySelector('.saved-icon');

      if (isSaved) {
        saveIcon?.classList.add('hidden');
        savedIcon?.classList.remove('hidden');
      } else {
        saveIcon?.classList.remove('hidden');
        savedIcon?.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll('.save-speaker-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const speakerId = (btn as HTMLElement).dataset.speakerId;
      const speakerName = (btn as HTMLElement).dataset.speakerName;

      const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
      const existingIndex = saved.findIndex((item: any) => item.id === speakerId);

      if (existingIndex >= 0) {
        saved.splice(existingIndex, 1);
      } else {
        saved.push({
          id: speakerId,
          type: 'speaker',
          title: speakerName,
          timestamp: Date.now()
        });
      }

      localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
      updateSpeakerButtons();
      window.dispatchEvent(new Event('saved-items-updated'));
    });
  });

  updateSaveButton();
  updateSpeakerButtons();
</script>
