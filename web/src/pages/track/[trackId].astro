---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import type { TrackType } from '../../types';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

export function getStaticPaths() {
  return [
    { params: { trackId: 'leadership' } },
    { params: { trackId: 'engineering' } }
  ];
}

const { trackId } = Astro.params;
const track = trackId?.toUpperCase() as TrackType;

// Helper function to calculate reading time
// Assumes average reading speed of 200 words per minute
function calculateReadingTime(content: string): string {
  const wordsPerMinute = 200;
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}

// Load articles from content collection
const allArticles = await getCollection('articles');

// Determine track from file path
const articlesWithTrack = allArticles.map((article: any) => {
  const isLeadership = article.id.includes('trust-role') ||
                       article.id.includes('context-memory') ||
                       article.id.includes('sdlc-evolution') ||
                       article.id.includes('roi-reality') ||
                       article.id.includes('proactive-vs') ||
                       article.id.includes('economics-ai');

  return {
    id: article.id,
    title: article.data.title,
    order: article.data.order,
    track: isLeadership ? 'LEADERSHIP' : 'ENGINEERING',
    subtitle: article.data.key_insights?.[0] || '',
    authors: article.data.key_speakers || ['Various'],
    readTime: calculateReadingTime(article.body),
    imageUrl: article.data.header_image || 'https://picsum.photos/seed/ai_art/1200/600',
  };
});

const articles = articlesWithTrack
  .filter((a: any) => a.track === track)
  .sort((a: any, b: any) => a.order - b.order);

const getTrackDescription = () => {
  if (track === 'LEADERSHIP') {
    return "AI isn't replacing software engineering fundamentals—it's amplifying them, making the difference between clean code and technical debt more consequential than ever before.";
  }
  return "The war on 'slop' isn't won through clever engineering—it requires keeping human thinking at the center, treating environments as universal abstraction, and investing in model capability over scaffolding.";
};
---

<BaseLayout title={`${track} - AI Engineering Code Summit`}>
  <div class="w-full min-h-screen bg-paper animate-in fade-in duration-500 pb-20">

    <!-- Magazine Cover Header -->
    <div class="max-w-7xl mx-auto border-x border-void bg-void text-white p-8 md:p-16 relative">
      <a href={`${base}/`} class="absolute top-6 left-6 flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-gray-400 hover:text-white transition-colors">
        <ArrowLeft className="w-4 h-4" /> Index
      </a>

      <div class="mt-12 mb-8">
        <span class="font-mono text-sm uppercase tracking-[0.5em] text-alert-red block mb-2">
          Department of
        </span>
        <h1 class="text-6xl md:text-9xl font-sans font-black tracking-tighter leading-none">
          {track}
        </h1>
      </div>

      <div class="flex flex-col md:flex-row gap-12 border-t border-gray-700 pt-8">
        <p class="flex-1 font-serif text-xl leading-relaxed text-gray-300 max-w-2xl">
          {getTrackDescription()}
        </p>
        <div class="font-mono text-xs text-right text-gray-500 uppercase flex flex-col justify-between">
          <span>Vol. 2025</span>
          <span>Classified: No</span>
          <span>Pages: {articles.length * 12}</span>
        </div>
      </div>
    </div>

    <!-- Dynamic Grid Layout -->
    <div class="max-w-7xl mx-auto border-x border-b border-void bg-[#f3f2ea]">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-void border-t border-void">

        {articles.map((article, idx) => {
          // Make the first item large
          const isFeature = idx === 0;
          const colSpan = isFeature ? "md:col-span-2" : "md:col-span-1";

          return (
            <a
              href={`${base}/article/${article.id}`}
              class={`${colSpan} bg-white p-8 cursor-pointer group hover:bg-[#fdfdfc] transition-all relative min-h-[300px] flex flex-col justify-between`}
            >
              <div>
                <div class="flex justify-between items-start mb-4">
                  <span class="font-mono text-xs font-bold text-white bg-void px-2 py-1">
                    SEC 0{article.order}
                  </span>
                  <ArrowRight className="w-5 h-5 text-gray-300 group-hover:text-rand-blue transition-colors" />
                </div>

                <h2 class={`${isFeature ? 'text-4xl md:text-5xl' : 'text-2xl'} font-sans font-black uppercase mb-4 leading-tight group-hover:text-rand-blue transition-colors`}>
                  {article.title}
                </h2>

                <p class={`${isFeature ? 'text-lg' : 'text-sm'} font-mono text-gray-600 mb-6 leading-relaxed`}>
                  {article.subtitle}
                </p>
              </div>

              <div class="pt-4 border-t border-dashed border-gray-300 flex justify-between items-end">
                <div class="font-mono text-[10px] uppercase text-gray-500">
                  <div class="mb-1">Auth: {article.authors.map((a: string) => a.replace(/\s*\([^)]+\)\s*$/, '').trim()).join(', ')}</div>
                  <div>Time: {article.readTime}</div>
                </div>
                {isFeature && (
                  <div class="hidden md:block w-32 h-20 bg-gray-200 overflow-hidden grayscale contrast-125 mix-blend-multiply opacity-50">
                    <img src={article.imageUrl} alt="" class="w-full h-full object-cover" />
                  </div>
                )}
              </div>
            </a>
          );
        })}

        {/* Filler block if odd number of items to keep grid tight */}
        {articles.length % 3 !== 0 && (
          <div class="bg-paper p-8 flex items-center justify-center">
            <div class="w-12 h-12 border border-gray-300 rounded-full flex items-center justify-center opacity-20">
              <div class="w-2 h-2 bg-void rounded-full"></div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
