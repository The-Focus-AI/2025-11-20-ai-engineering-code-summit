---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowLeft, ExternalLink } from 'lucide-react';
import { getCollection, render } from 'astro:content';

// Load about content from collection (reads from ../about.md)
const aboutCollection = await getCollection('about');
const aboutEntry = aboutCollection[0];
const { Content } = await render(aboutEntry);
const frontmatter = aboutEntry.data;

// Load bio content from collection (reads from ../bio.md)
const bioCollection = await getCollection('bio');
const bioEntry = bioCollection[0];
const { Content: BioContent } = await render(bioEntry);
const bioData = bioEntry.data;
---

<BaseLayout
  title="About - AI Engineering Code Summit"
  description="About this analysis of the AI Engineering World's Fair Code Summit and the methodology behind the research."
  url="/about"
>
  <div class="w-full min-h-screen bg-paper pb-20">
    <div class="max-w-4xl mx-auto bg-[#fdfdfc] border-x border-void min-h-screen shadow-lg">

      <!-- Toolbar -->
      <div class="sticky top-0 z-40 bg-paper border-b border-void p-3 flex justify-between items-center print:hidden border-x border-void mx-[-1px]">
        <a
          href="./"
          class="flex items-center gap-2 text-void hover:text-rand-blue transition-colors font-mono font-bold text-xs uppercase tracking-widest px-2"
        >
          <ArrowLeft className="w-4 h-4" />
          Back to Summary
        </a>
      </div>

      <!-- Page Content -->
      <div class="px-8 md:px-24 py-16">

        <!-- Header Block -->
        <div class="mb-12 border-b-4 border-void pb-8">
          <span class="font-mono text-xs uppercase tracking-widest text-gray-500 block mb-2">Project Documentation</span>
          <h1 class="text-4xl md:text-6xl font-sans font-black text-void leading-none uppercase mb-6">
            About This Report
          </h1>
          {frontmatter.event && (
            <p class="font-mono text-sm text-gray-600">
              Comprehensive analysis and synthesis from the {frontmatter.event}
            </p>
          )}
        </div>

        <!-- Workflow Diagram -->
        {frontmatter.diagram && (
          <div class="my-8">
            <img
              src={frontmatter.diagram}
              alt="Report workflow diagram"
              class="w-full rounded-lg border border-gray-200"
            />
            <p class="font-mono text-xs text-gray-500 mt-2 text-center">How this report was created</p>
          </div>
        )}

        <!-- Conference Meta Box -->
        {(frontmatter.dates || frontmatter.location || frontmatter.website) && (
          <div class="border-l-4 border-rand-blue pl-6 py-4 my-8 bg-gray-50 not-prose">
            <p class="font-sans font-bold text-base mb-3">Conference Details</p>
            <div class="font-mono text-sm space-y-1 text-gray-700">
              {frontmatter.dates && <p><strong>Dates:</strong> {frontmatter.dates}</p>}
              {frontmatter.attended_dates && <p><strong>Attended:</strong> {frontmatter.attended_dates}</p>}
              {frontmatter.location && <p><strong>Location:</strong> {frontmatter.location}</p>}
              {frontmatter.format && <p><strong>Format:</strong> {frontmatter.format}</p>}
              {frontmatter.website && (
                <p>
                  <strong>Website:</strong>{' '}
                  <a href={frontmatter.website} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                    {frontmatter.website.replace('https://', '')} <ExternalLink className="w-3 h-3" />
                  </a>
                </p>
              )}
            </div>
          </div>
        )}

        <!-- Content from Markdown -->
        <article class="prose prose-lg max-w-none
          prose-headings:font-sans prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight
          prose-h1:text-4xl prose-h1:mt-16 prose-h1:mb-8 prose-h1:border-b-2 prose-h1:border-void prose-h1:pb-4
          prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6
          prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-4
          prose-p:font-mono prose-p:text-base prose-p:leading-8 prose-p:my-5
          prose-ul:my-6 prose-li:my-2 prose-li:font-mono prose-li:text-base prose-li:leading-7
          prose-ol:my-6 prose-ol:list-decimal
          prose-blockquote:border-l-4 prose-blockquote:border-rand-blue prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:my-10 prose-blockquote:font-sans prose-blockquote:text-xl prose-blockquote:leading-9 prose-blockquote:font-bold prose-blockquote:not-italic
          prose-a:text-rand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
          prose-strong:font-bold
          prose-hr:my-12 prose-hr:border-gray-300
        ">
          <Content />
        </article>

        <!-- Bio Section -->
        <div class="mt-16 pt-12 border-t-4 border-void">
          <span class="font-mono text-xs uppercase tracking-widest text-gray-500 block mb-2">About the Author</span>
          <div class="flex flex-col md:flex-row gap-6 mb-8">
            <div class="flex-1">
              <h2 class="text-2xl md:text-3xl font-sans font-black text-void leading-none uppercase mb-2">
                {bioData.name}
              </h2>
              {bioData.title && bioData.company && (
                <p class="font-mono text-sm text-gray-600 mb-4">
                  {bioData.title}, {bioData.company_url ? (
                    <a href={bioData.company_url} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                      {bioData.company} <ExternalLink className="w-3 h-3" />
                    </a>
                  ) : bioData.company}
                </p>
              )}
              {bioData.tagline && (
                <p class="font-mono text-sm text-gray-700 italic">{bioData.tagline}</p>
              )}
            </div>
          </div>

          {bioData.services && bioData.services.length > 0 && (
            <div class="border-l-4 border-rand-blue pl-6 py-4 my-8 bg-gray-50 not-prose">
              <p class="font-sans font-bold text-base mb-3">Services</p>
              <ul class="font-mono text-sm space-y-1 text-gray-700">
                {bioData.services.map((service: string) => (
                  <li class="flex items-center gap-2">
                    <span class="text-rand-blue">→</span> {service}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <article class="prose prose-lg max-w-none
            prose-headings:font-sans prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
            prose-p:font-mono prose-p:text-base prose-p:leading-8 prose-p:my-5
            prose-ul:my-6 prose-li:my-2 prose-li:font-mono prose-li:text-base prose-li:leading-7
            prose-a:text-rand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
            prose-strong:font-bold
          ">
            <BioContent />
          </article>

          <!-- Social Links -->
          {(bioData.website || bioData.github || bioData.twitter || bioData.linkedin) && (
            <div class="flex flex-wrap gap-4 mt-8 font-mono text-sm">
              {bioData.website && (
                <a href={`https://${bioData.website}`} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                  Website <ExternalLink className="w-3 h-3" />
                </a>
              )}
              {bioData.github && (
                <a href={`https://github.com/${bioData.github}`} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                  GitHub <ExternalLink className="w-3 h-3" />
                </a>
              )}
              {bioData.twitter && (
                <a href={`https://x.com/${bioData.twitter}`} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                  Twitter/X <ExternalLink className="w-3 h-3" />
                </a>
              )}
              {bioData.linkedin && (
                <a href={`https://linkedin.com/in/${bioData.linkedin}`} target="_blank" rel="noopener noreferrer" class="text-rand-blue hover:underline inline-flex items-center gap-1">
                  LinkedIn <ExternalLink className="w-3 h-3" />
                </a>
              )}
            </div>
          )}
        </div>

        <!-- Document Reference Footer -->
        <div class="border-l-4 border-alert-red pl-6 py-4 mt-16 bg-gray-50">
          <p class="font-sans font-bold text-sm uppercase mb-2">Document Reference</p>
          <p class="font-mono text-xs">
            {frontmatter.doc_no && <>DOC. NO: {frontmatter.doc_no}<br/></>}
            {frontmatter.event && <>PROJECT: {frontmatter.event}<br/></>}
            CLASSIFICATION: UNCLASSIFIED
          </p>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
