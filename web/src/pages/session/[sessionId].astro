---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, Bookmark, Calendar, Clock } from 'lucide-react';
import { getCollection, getEntry, render } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const allSessions = await getCollection('sessions');
  // Filter out non-session files (lunch, expo, afterparty, etc.) and sessions with no ID
  const sessions = allSessions.filter(s => s.data.speaker && s.data.company && s.id);
  return sessions.map(session => ({
    params: { sessionId: session.id }
  }));
}

const { sessionId } = Astro.params;
const sessionEntry = await getEntry('sessions', sessionId);

if (!sessionEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(sessionEntry);

// Extract time from session ID (e.g., "2025-11-21/11-21-12-00-will-hang-cathy-zhou-openai.md")
const timeMatch = sessionId.match(/\d{2}-\d{2}-(\d{2})-(\d{2})/);
const time = timeMatch ? `${timeMatch[1]}:${timeMatch[2]}` : '';

// Extract date from session ID
const dateMatch = sessionId.match(/(\d{4}-\d{2}-\d{2})/);
const date = dateMatch ? dateMatch[1] : '';

const session = {
  id: sessionEntry.id,
  title: sessionEntry.data.title || 'Untitled Session',
  speaker: sessionEntry.data.speaker || 'Unknown Speaker',
  company: sessionEntry.data.company || 'Unknown Company',
  track: sessionEntry.data.track || 'General',
  topics: sessionEntry.data.topics || [],
  time,
  date
};

// Find related articles that mention this session's speakers
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((article: any) => {
    const speakers = article.data.key_speakers || [];
    return speakers.some((s: string) => {
      const cleanName = s.replace(/\s*\([^)]+\)\s*$/, '').trim();
      return session.speaker.includes(cleanName);
    });
  })
  .map((article: any) => ({
    id: article.id,
    title: article.data.title,
    order: article.data.order
  }))
  .sort((a: any, b: any) => a.order - b.order);
---

<BaseLayout title={`${session.title} - AI Engineering Code Summit`}>
  <div class="w-full min-h-screen bg-paper pb-20 animate-in fade-in duration-300">

    <div class="max-w-4xl mx-auto bg-[#fdfdfc] border-x border-void min-h-screen shadow-lg relative">

      <!-- Toolbar -->
      <div class="sticky top-0 z-40 bg-paper border-b border-void p-3 flex justify-between items-center print:hidden border-x border-void mx-[-1px]">
        <a
          href={`${base}/sessions`}
          class="flex items-center gap-2 text-void hover:text-rand-blue transition-colors font-mono font-bold text-xs uppercase tracking-widest px-2"
        >
          <ArrowLeft className="w-4 h-4" />
          All Sessions
        </a>

        <div class="flex items-center gap-4 px-2">
          <button
            id="save-button"
            data-session-id={session.id}
            data-session-title={session.title}
            class="flex items-center gap-2 text-xs font-mono uppercase text-gray-500 hover:text-void"
          >
            <Bookmark className="w-4 h-4" />
            <span class="save-text">File</span>
          </button>
        </div>
      </div>

      <!-- Page Content -->
      <div class="px-8 md:px-24 py-16">

        <!-- Header Block -->
        <div class="mb-12">
          <div class="flex justify-between items-start border-b-4 border-void pb-4 mb-8">
            <div class="flex-1">
              <div class="flex items-center gap-4 mb-4">
                <span class="font-mono text-xs uppercase tracking-widest px-3 py-1 bg-void text-paper">
                  {session.track}
                </span>
                {session.topics.map(topic => (
                  <span class="font-mono text-xs uppercase tracking-widest text-gray-500">
                    {topic}
                  </span>
                ))}
              </div>
              <h1 class="text-3xl md:text-5xl font-sans font-black text-void leading-none uppercase mb-4">
                {session.title}
              </h1>
              <div class="flex items-center gap-6 text-sm font-mono text-gray-600">
                <div class="flex items-center gap-2">
                  <Calendar className="w-4 h-4" />
                  {new Date(session.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </div>
                <div class="flex items-center gap-2">
                  <Clock className="w-4 h-4" />
                  {session.time}
                </div>
              </div>
            </div>
          </div>

          <div class="mb-8">
            <p class="font-mono text-sm text-gray-600 uppercase mb-2">Speaker(s)</p>
            <p class="text-xl font-sans font-bold text-void">{session.speaker}</p>
            <p class="font-mono text-sm text-gray-500">{session.company}</p>
          </div>
        </div>

        <!-- Session Notes -->
        <article class="prose prose-lg max-w-none prose-headings:font-sans prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-4 prose-p:font-mono prose-p:text-lg prose-p:leading-8 prose-p:my-6 prose-ul:my-6 prose-li:my-3 prose-li:font-mono prose-li:text-lg prose-li:leading-8 prose-blockquote:border-l-4 prose-blockquote:border-rand-blue prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:my-10 prose-blockquote:font-sans prose-blockquote:text-xl prose-blockquote:leading-9 prose-blockquote:font-bold prose-blockquote:not-italic prose-a:text-rand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-img:border-2 prose-img:border-void prose-img:shadow-lg prose-img:my-10 border-b border-dashed border-gray-400 pb-12">
          <Content />
        </article>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <div class="mt-12">
            <h4 class="font-sans font-bold text-sm uppercase mb-2 flex items-center gap-2">
              <span class="w-2 h-2 bg-alert-red rounded-full"></span>
              Related Analysis
            </h4>
            <p class="font-mono text-xs text-gray-600 mb-6">
              This session is featured in the following thematic articles
            </p>

            <div class="space-y-3">
              {relatedArticles.map(article => (
                <a
                  href={`${base}/article/${article.id}`}
                  class="block border border-gray-300 bg-white p-4 hover:border-void hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] transition-all cursor-pointer group"
                >
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="font-mono text-xs text-gray-400 uppercase">Section {String(article.order).padStart(2, '0')}</span>
                      <h5 class="font-sans font-bold text-sm group-hover:text-rand-blue transition-colors mt-1">{article.title}</h5>
                    </div>
                    <ArrowLeft className="w-4 h-4 text-gray-300 group-hover:text-rand-blue transition-colors rotate-180" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Save/unsave session functionality
  function updateSaveButton() {
    const button = document.getElementById('save-button');
    if (!button) return;

    const sessionId = button.dataset.sessionId;
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const isSaved = saved.some((item: any) => item.id === sessionId);

    const textEl = button.querySelector('.save-text');
    if (textEl) {
      textEl.textContent = isSaved ? 'Filed' : 'File';
    }
    button.classList.toggle('text-alert-red', isSaved);
    button.classList.toggle('font-bold', isSaved);
    button.classList.toggle('text-gray-500', !isSaved);
  }

  document.getElementById('save-button')?.addEventListener('click', () => {
    const button = document.getElementById('save-button');
    if (!button) return;

    const sessionId = button.dataset.sessionId;
    const sessionTitle = button.dataset.sessionTitle;

    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const existingIndex = saved.findIndex((item: any) => item.id === sessionId);

    if (existingIndex >= 0) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        id: sessionId,
        type: 'session',
        title: sessionTitle,
        timestamp: Date.now()
      });
    }

    localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
    updateSaveButton();
    window.dispatchEvent(new Event('saved-items-updated'));
  });

  updateSaveButton();
</script>
