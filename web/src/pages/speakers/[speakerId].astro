---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, Globe, Linkedin, Twitter, Bookmark, Check } from 'lucide-react';
import { SPEAKERS, ARTICLES } from '../../constants';

export function getStaticPaths() {
  return SPEAKERS.map(speaker => ({
    params: { speakerId: speaker.id }
  }));
}

const { speakerId } = Astro.params;
const speaker = SPEAKERS.find(s => s.id === speakerId);

if (!speaker) {
  return Astro.redirect('/404');
}

const authoredArticles = ARTICLES.filter(a => a.contributorIds.includes(speaker.id));
---

<BaseLayout title={`${speaker.name} - Horizon 2025`}>
  <div class="min-h-screen bg-[#e8e6df] p-4 md:p-8 animate-in slide-in-from-bottom-4 duration-500">
    <div class="max-w-5xl mx-auto bg-paper shadow-2xl border border-void min-h-[80vh] flex flex-col md:flex-row relative">

      <!-- Top Tab -->
      <div class="absolute -top-4 left-0 bg-void text-white px-4 py-1 font-mono text-xs font-bold uppercase tracking-widest">
        Personnel File: {speaker.id}
      </div>

      <a
        href="/speakers"
        class="absolute top-4 right-4 z-10 p-2 hover:bg-gray-200 rounded-full transition-colors"
      >
        <ArrowLeft className="w-6 h-6" />
      </a>

      <!-- Left Column: Vitals -->
      <div class="w-full md:w-1/3 bg-[#dcdad4] p-8 border-r border-void flex flex-col">
        <div class="w-full aspect-[4/5] bg-gray-300 border-4 border-white shadow-lg mb-8 relative group rotate-1">
          <img
            src={speaker.imageUrl}
            alt={speaker.name}
            class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-500"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-void text-white text-center py-1 font-mono text-[10px] uppercase">
            ID_VERIFIED
          </div>
        </div>

        <div class="space-y-4 font-mono text-xs">
          <div class="border-b border-gray-400 pb-2">
            <span class="block text-gray-500 uppercase text-[9px]">Full Name</span>
            <span class="font-bold text-sm">{speaker.name}</span>
          </div>
          <div class="border-b border-gray-400 pb-2">
            <span class="block text-gray-500 uppercase text-[9px]">Designation</span>
            <span class="font-bold">{speaker.role}</span>
          </div>
          <div class="border-b border-gray-400 pb-2">
            <span class="block text-gray-500 uppercase text-[9px]">Affiliation</span>
            <span class="font-bold">{speaker.company}</span>
          </div>
          <div class="pt-2">
            <span class="block text-gray-500 uppercase text-[9px] mb-2">Connect</span>
            <div class="flex gap-2">
              {speaker.websiteUrl && (
                <a href={speaker.websiteUrl} class="p-1 border border-gray-400 hover:bg-void hover:text-white">
                  <Globe className="w-4 h-4"/>
                </a>
              )}
              {speaker.twitterUrl && (
                <a href={speaker.twitterUrl} class="p-1 border border-gray-400 hover:bg-void hover:text-white">
                  <Twitter className="w-4 h-4"/>
                </a>
              )}
              {speaker.linkedinUrl && (
                <a href={speaker.linkedinUrl} class="p-1 border border-gray-400 hover:bg-void hover:text-white">
                  <Linkedin className="w-4 h-4"/>
                </a>
              )}
            </div>
          </div>
        </div>

        <button
          id="save-speaker-button"
          data-speaker-id={speaker.id}
          data-speaker-name={speaker.name}
          class="mt-auto w-full py-3 font-mono font-bold uppercase text-xs flex items-center justify-center gap-2 border border-void transition-colors hover:bg-white"
        >
          <Bookmark className="w-4 h-4 save-icon" />
          <Check className="w-4 h-4 saved-icon hidden" />
          <span class="save-text">Track Subject</span>
        </button>
      </div>

      <!-- Right Column: Bio & Records -->
      <div class="flex-1 p-8 md:p-12 bg-[url('https://www.transparenttextures.com/patterns/cream-paper.png')]">
        <div class="mb-12">
          <h1 class="text-4xl md:text-5xl font-sans font-black uppercase text-void mb-2">{speaker.name}</h1>
          <p class="font-mono text-sm text-rand-blue font-bold uppercase tracking-widest mb-8">{speaker.role} // {speaker.company}</p>

          <div class="prose font-serif text-lg leading-relaxed text-gray-800 text-justify">
            <p>{speaker.bio}</p>
            <p>
              Additional background check: Cleared for Level 5 systems access.
              Subject has demonstrated exceptional aptitude in high-pressure
              strategic environments. Previous tenure at major research
              institutions has been verified.
            </p>
          </div>
        </div>

        <!-- Contributions -->
        <div class="border-t-2 border-void pt-8">
          <h3 class="font-mono text-xs font-bold uppercase tracking-widest text-gray-500 mb-6 flex items-center gap-2">
            <span class="w-2 h-2 bg-alert-red rounded-full"></span>
            Operational Debriefs (Articles)
          </h3>

          <div class="grid gap-4">
            {authoredArticles.length > 0 ? (
              authoredArticles.map(article => (
                <a
                  href={`/article/${article.id}`}
                  class="border border-gray-300 bg-white p-4 cursor-pointer hover:border-rand-blue hover:shadow-md transition-all group"
                >
                  <div class="flex justify-between items-start">
                    <h4 class="font-sans font-bold text-lg uppercase group-hover:text-rand-blue">{article.title}</h4>
                    <span class="font-mono text-[9px] uppercase bg-gray-100 px-2 py-1">{article.track}</span>
                  </div>
                  <p class="font-mono text-xs text-gray-600 mt-2 line-clamp-2">{article.subtitle}</p>
                </a>
              ))
            ) : (
              <p class="font-mono text-xs text-gray-400 italic">No public reports filed.</p>
            )}
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script>
  function updateSaveButton() {
    const button = document.getElementById('save-speaker-button');
    if (!button) return;

    const speakerId = button.dataset.speakerId;
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const isSaved = saved.some((item: any) => item.id === speakerId);

    const textEl = button.querySelector('.save-text');
    const saveIcon = button.querySelector('.save-icon');
    const savedIcon = button.querySelector('.saved-icon');

    if (isSaved) {
      if (textEl) textEl.textContent = 'Subject Tracked';
      button.classList.add('bg-void', 'text-white');
      button.classList.remove('hover:bg-white');
      saveIcon?.classList.add('hidden');
      savedIcon?.classList.remove('hidden');
    } else {
      if (textEl) textEl.textContent = 'Track Subject';
      button.classList.remove('bg-void', 'text-white');
      button.classList.add('hover:bg-white');
      saveIcon?.classList.remove('hidden');
      savedIcon?.classList.add('hidden');
    }
  }

  document.getElementById('save-speaker-button')?.addEventListener('click', () => {
    const button = document.getElementById('save-speaker-button');
    if (!button) return;

    const speakerId = button.dataset.speakerId;
    const speakerName = button.dataset.speakerName;

    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const existingIndex = saved.findIndex((item: any) => item.id === speakerId);

    if (existingIndex >= 0) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        id: speakerId,
        type: 'speaker',
        title: speakerName,
        timestamp: Date.now()
      });
    }

    localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
    updateSaveButton();
    window.dispatchEvent(new Event('saved-items-updated'));
  });

  updateSaveButton();
</script>
