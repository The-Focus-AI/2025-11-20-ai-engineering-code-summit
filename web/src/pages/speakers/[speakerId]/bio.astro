---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowLeft, FileText, Bookmark, Check, Linkedin, Twitter, Github, Globe } from 'lucide-react';
import { getCollection, getEntry, render } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const speakers = await getCollection('speakers');
  return speakers.map((speaker: any) => ({
    params: { speakerId: speaker.id }
  }));
}

const { speakerId } = Astro.params;
const speakerEntry = await getEntry('speakers', speakerId);

if (!speakerEntry) {
  return Astro.redirect('/404');
}

const speaker = {
  id: speakerEntry.id,
  name: speakerEntry.data.name,
  role: speakerEntry.data.role,
  company: speakerEntry.data.company,
  session: speakerEntry.data.session || undefined,
  session_file: speakerEntry.data.session_file || undefined,
  imageUrl: `/photos/${speakerEntry.id}.jpg`,
  linkedin: speakerEntry.data.linkedin || undefined,
  twitter: speakerEntry.data.twitter || undefined,
  twitter_url: speakerEntry.data.twitter_url || undefined,
  github: speakerEntry.data.github || undefined,
  github_url: speakerEntry.data.github_url || undefined,
  website: speakerEntry.data.website || undefined,
};

// Render the markdown content (bio)
const { Content } = await render(speakerEntry);

// Find related articles that mention this speaker
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((article: any) => {
    const speakers = article.data.key_speakers || [];
    return speakers.some((s: string) => {
      const cleanName = s.replace(/\s*\([^)]+\)\s*$/, '').trim();
      return cleanName === speaker.name;
    });
  })
  .map((article: any) => {
    const isLeadership = article.id.includes('trust-role') ||
                         article.id.includes('context-memory') ||
                         article.id.includes('sdlc-evolution') ||
                         article.id.includes('roi-reality') ||
                         article.id.includes('proactive-vs') ||
                         article.id.includes('economics-ai');
    return {
      id: article.id,
      title: article.data.title,
      order: article.data.order,
      track: isLeadership ? 'LEADERSHIP' : 'ENGINEERING'
    };
  })
  .sort((a: any, b: any) => a.order - b.order);
---

<BaseLayout title={`${speaker.name} - Biography`}>
  <div class="w-full min-h-screen bg-paper pb-20">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row border-x border-void bg-[#fdfdfc] min-h-screen">

      <!-- Left Sidebar: Speaker Info & Related Themes (SAME AS SESSION PAGE) -->
      <div class="w-full md:w-80 bg-[#dcdad4] border-r border-void flex flex-col md:sticky md:top-0 md:h-screen md:overflow-y-auto">
        <div class="p-6 border-b border-void">
          <a href="/speakers" class="flex items-center gap-2 font-mono text-xs uppercase text-gray-600 hover:text-void mb-6">
            <ArrowLeft className="w-4 h-4" />
            All Speakers
          </a>

          <div class="w-full aspect-square bg-gray-300 border-2 border-white shadow-lg mb-4">
            <img
              src={speaker.imageUrl}
              alt={speaker.name}
              class="w-full h-full object-cover grayscale contrast-125"
            />
          </div>

          <h2 class="font-sans font-bold text-xl uppercase text-void mb-1">{speaker.name}</h2>
          <p class="font-mono text-xs text-gray-600 mb-1">{speaker.role}</p>
          <p class="font-mono text-xs text-gray-500 mb-3">{speaker.company}</p>

          {(speaker.linkedin || speaker.twitter_url || speaker.github_url || speaker.website) && (
            <div class="flex items-center gap-2 mb-4">
              {speaker.linkedin && (
                <a
                  href={`https://www.linkedin.com/in/${speaker.linkedin}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 border border-void hover:bg-void hover:text-white transition-colors"
                  title="LinkedIn"
                >
                  <Linkedin className="w-4 h-4" />
                </a>
              )}
              {speaker.twitter_url && (
                <a
                  href={speaker.twitter_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 border border-void hover:bg-void hover:text-white transition-colors"
                  title="Twitter/X"
                >
                  <Twitter className="w-4 h-4" />
                </a>
              )}
              {speaker.github_url && (
                <a
                  href={speaker.github_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 border border-void hover:bg-void hover:text-white transition-colors"
                  title="GitHub"
                >
                  <Github className="w-4 h-4" />
                </a>
              )}
              {speaker.website && (
                <a
                  href={speaker.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 border border-void hover:bg-void hover:text-white transition-colors"
                  title="Website"
                >
                  <Globe className="w-4 h-4" />
                </a>
              )}
            </div>
          )}

          <!-- Navigation Toggle -->
          <div class="mt-4 border border-void bg-white">
            <a
              href={`/speakers/${speaker.id}`}
              class="w-full py-2 px-3 font-mono text-xs uppercase hover:bg-gray-100 transition-colors flex items-center justify-center gap-2 border-b border-void"
            >
              Session Notes
            </a>
            <a
              href={`/speakers/${speaker.id}/bio`}
              class="w-full py-2 px-3 font-mono text-xs uppercase bg-void text-white flex items-center justify-center gap-2"
            >
              <FileText className="w-4 h-4" />
              Biography
            </a>
          </div>

          <button
            id="save-speaker-button"
            data-speaker-id={speaker.id}
            data-speaker-name={speaker.name}
            class="mt-2 w-full py-2 px-3 border border-void font-mono text-xs uppercase hover:bg-void hover:text-white transition-colors flex items-center justify-center gap-2"
          >
            <Bookmark className="w-4 h-4 save-icon" />
            <Check className="w-4 h-4 saved-icon hidden" />
            <span class="save-text">Track</span>
          </button>
        </div>

        <!-- Related Theme Articles -->
        {relatedArticles.length > 0 && (
          <div class="p-6 flex-1 overflow-y-auto">
            <h3 class="font-mono text-xs uppercase tracking-widest text-gray-600 mb-4 flex items-center gap-2">
              <span class="w-2 h-2 bg-alert-red rounded-full"></span>
              Related Themes
            </h3>

            <div class="space-y-2">
              {relatedArticles.map(article => (
                <a
                  href={`/article/${article.id}`}
                  class="block border border-gray-300 bg-white p-3 hover:border-void hover:bg-gray-50 transition-all group"
                >
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <span class="font-mono text-[9px] text-gray-400 uppercase">{article.track}</span>
                    <span class="font-mono text-[9px] text-gray-400">#{String(article.order).padStart(2, '0')}</span>
                  </div>
                  <h4 class="font-sans font-bold text-xs uppercase group-hover:text-rand-blue line-clamp-2">{article.title}</h4>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Main Content: Biography -->
      <div class="flex-1 flex flex-col">
        <!-- Navigation Tabs -->
        <div class="border-b border-void bg-paper px-8 pt-4 flex gap-1">
          <a
            href={`/speakers/${speaker.id}`}
            class="px-6 py-3 font-mono text-xs font-bold uppercase bg-[#dcdad4] border-t border-x border-void hover:bg-white transition-colors"
          >
            Session Notes
          </a>
          <a
            href={`/speakers/${speaker.id}/bio`}
            class="px-6 py-3 font-mono text-xs font-bold uppercase bg-white border-t border-x border-void relative top-[1px]"
          >
            Biography
          </a>
        </div>

        <div class="flex-1 p-8 md:p-12">
          <div class="max-w-3xl">
            <div class="mb-8">
              <span class="font-mono text-xs uppercase tracking-widest text-gray-500 block mb-2">Expert Biography</span>
              <h1 class="text-4xl md:text-5xl font-sans font-black uppercase text-void leading-tight">{speaker.name}</h1>
            </div>

            <!-- Biography Content -->
            <article class="prose prose-lg max-w-none prose-headings:font-sans prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-4 prose-p:font-mono prose-p:text-lg prose-p:leading-8 prose-p:my-6 prose-ul:my-6 prose-li:my-3 prose-li:font-mono prose-li:text-lg prose-li:leading-8 prose-blockquote:border-l-4 prose-blockquote:border-rand-blue prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:my-10 prose-blockquote:font-sans prose-blockquote:text-xl prose-blockquote:leading-9 prose-blockquote:font-bold prose-blockquote:not-italic prose-a:text-rand-blue prose-a:font-semibold prose-a:no-underline hover:prose-a:underline">
              <Content />
            </article>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  function updateSaveButton() {
    const button = document.getElementById('save-speaker-button');
    if (!button) return;

    const speakerId = button.dataset.speakerId;
    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const isSaved = saved.some((item: any) => item.id === speakerId);

    const textEl = button.querySelector('.save-text');
    const saveIcon = button.querySelector('.save-icon');
    const savedIcon = button.querySelector('.saved-icon');

    if (isSaved) {
      if (textEl) textEl.textContent = 'Tracked';
      button.classList.add('bg-void', 'text-white');
      saveIcon?.classList.add('hidden');
      savedIcon?.classList.remove('hidden');
    } else {
      if (textEl) textEl.textContent = 'Track';
      button.classList.remove('bg-void', 'text-white');
      saveIcon?.classList.remove('hidden');
      savedIcon?.classList.add('hidden');
    }
  }

  document.getElementById('save-speaker-button')?.addEventListener('click', () => {
    const button = document.getElementById('save-speaker-button');
    if (!button) return;

    const speakerId = button.dataset.speakerId;
    const speakerName = button.dataset.speakerName;

    const saved = JSON.parse(localStorage.getItem('horizon_saved_research') || '[]');
    const existingIndex = saved.findIndex((item: any) => item.id === speakerId);

    if (existingIndex >= 0) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        id: speakerId,
        type: 'speaker',
        title: speakerName,
        timestamp: Date.now()
      });
    }

    localStorage.setItem('horizon_saved_research', JSON.stringify(saved));
    updateSaveButton();
    window.dispatchEvent(new Event('saved-items-updated'));
  });

  updateSaveButton();
</script>
