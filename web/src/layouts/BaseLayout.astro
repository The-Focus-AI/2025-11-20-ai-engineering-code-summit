---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import ResearchSidebar from '../components/ResearchSidebar';
import ChatAssistant from '../components/ChatAssistant';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = 'AI Engineering Code Summit 2025 Report',
  description = 'AI Engineering World\'s Fair Code Summit - Analysis and insights from the cutting edge of AI engineering',
  image,
  url
} = Astro.props;
const base = import.meta.env.BASE_URL;
// Use Astro's site config which handles the different deploy environments
const siteUrl = import.meta.env.SITE || 'https://the-focus-ai.github.io';
const fullBase = base.endsWith('/') ? base.slice(0, -1) : base;
const ogImage = image ? `${siteUrl}${fullBase}${image.startsWith('/') ? '' : '/'}${image}` : `${siteUrl}${fullBase}/headers/context-memory-harness.png`;
const canonicalUrl = url ? `${siteUrl}${fullBase}${url.startsWith('/') ? '' : '/'}${url}` : `${siteUrl}${fullBase}/`;
---

<!DOCTYPE html>
<html lang="en" class="min-h-screen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href={base} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AI Engineering Code Summit 2025" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen font-sans antialiased selection:bg-rand-blue selection:text-white">
    <div class="min-h-screen text-void font-sans bg-[#e8e6df]">
      <Navigation />

      <main class="pb-20 pt-8 px-4">
        <slot />
      </main>

      <NewsletterSignup />

      <ResearchSidebar client:load />
      <ChatAssistant client:load />
      <NewsletterPopup />
    </div>
  </body>
</html>
