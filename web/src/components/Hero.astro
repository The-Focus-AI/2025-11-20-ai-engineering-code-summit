---
import { ArrowRight, Database, Zap, MapPin, Calendar } from 'lucide-react';
import { APP_YEAR, CONFERENCE_DETAILS, ARTICLES } from '../constants';

const leadershipArticles = ARTICLES.filter(a => a.track === 'LEADERSHIP').sort((a,b) => a.order - b.order).slice(0, 4);
const engineeringArticles = ARTICLES.filter(a => a.track === 'ENGINEERING').sort((a,b) => a.order - b.order).slice(0, 4);
---

<div class="w-full min-h-[calc(100vh-8rem)] max-w-7xl mx-auto bg-paper relative flex flex-col md:flex-row shadow-[10px_10px_0px_0px_rgba(0,0,0,0.1)] border border-void">

  <!-- Left Strip: Binding -->
  <div class="w-full md:w-20 bg-rand-blue flex md:flex-col justify-between items-center py-4 md:py-8 shrink-0 border-r border-void">
    <div class="text-white font-mono text-xs rotate-0 md:-rotate-90 whitespace-nowrap tracking-[0.3em]">
      SYSTEMS ANALYSIS DIV.
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 p-8 md:p-12 flex flex-col relative overflow-hidden">

    <!-- Background Network Graphic -->
    <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
      <svg width="400" height="400" viewBox="0 0 100 100">
        <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="0.5" />
        <line x1="100" y1="0" x2="0" y2="100" stroke="currentColor" stroke-width="0.5" />
        <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="0.5" />
        <rect x="20" y="20" width="60" height="60" fill="none" stroke="currentColor" stroke-width="0.5" />
      </svg>
    </div>

    <!-- Header Metadata -->
    <div class="flex flex-col md:flex-row justify-between items-start mb-12 border-b-2 border-void pb-6 gap-4">
      <div class="font-mono text-xs space-y-1">
        <p class="font-bold">PROJECT: {CONFERENCE_DETAILS.title}</p>
        <p>DOC. NO: RM-{APP_YEAR}-HZ</p>
        <div class="flex items-center gap-4 mt-2 text-gray-600">
          <span class="flex items-center gap-1"><MapPin className="w-3 h-3"/> {CONFERENCE_DETAILS.location}</span>
          <span class="flex items-center gap-1"><Calendar className="w-3 h-3"/> {CONFERENCE_DETAILS.date}</span>
        </div>
      </div>
      <div class="font-mono text-xs font-bold border border-void px-3 py-1 bg-white shadow-sm self-start md:self-auto">
        UNCLASSIFIED
      </div>
    </div>

    <!-- Title Block -->
    <div class="mb-16 relative z-10">
      <h1 class="text-6xl md:text-8xl font-sans font-black text-void leading-[0.85] tracking-tight mb-8">
        FUTURE<br/>
        SYSTEMS<br/>
        <span class="text-rand-blue">REPORT</span>
      </h1>

      <p class="font-sans font-medium text-lg max-w-2xl leading-snug border-l-4 border-alert-red pl-6 py-2 mb-4">
        {CONFERENCE_DETAILS.summary}
      </p>
    </div>

    <!-- Track Selection Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-void border border-void">

      <!-- Leadership Track -->
      <a href="/track/leadership" class="bg-white p-8 group hover:bg-[#f8f8f6] transition-colors relative">
        <div class="flex justify-between items-start mb-6">
          <h3 class="font-sans font-black text-3xl uppercase">Leadership</h3>
          <Database className="w-6 h-6 text-gray-400 group-hover:text-rand-blue" />
        </div>

        <p class="font-mono text-xs mb-8 opacity-70 border-b border-dashed border-gray-400 pb-2">
          Strategic alignment & circular economics.
        </p>

        <!-- Detailed Theme List -->
        <div class="space-y-6">
          {leadershipArticles.map(a => (
            <div key={a.id} class="block">
              <h4 class="font-sans font-bold text-sm uppercase flex items-center gap-2">
                <span class="text-alert-red font-mono text-[10px]">0{a.order}</span>
                {a.title}
              </h4>
              <p class="font-mono text-[10px] text-gray-500 mt-1 pl-6 leading-tight truncate">
                {a.subtitle}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-rand-blue group-hover:underline decoration-2 underline-offset-4">
          Access Division Files <ArrowRight className="w-4 h-4" />
        </div>
      </a>

      <!-- Engineering Track -->
      <a href="/track/engineering" class="bg-white p-8 group hover:bg-[#f8f8f6] transition-colors relative">
        <div class="flex justify-between items-start mb-6">
          <h3 class="font-sans font-black text-3xl uppercase">Engineering</h3>
          <Zap className="w-6 h-6 text-gray-400 group-hover:text-rand-blue" />
        </div>

        <p class="font-mono text-xs mb-8 opacity-70 border-b border-dashed border-gray-400 pb-2">
          Quantum logistics & bio-infrastructure.
        </p>

        <!-- Detailed Theme List -->
        <div class="space-y-6">
          {engineeringArticles.map(a => (
            <div key={a.id} class="block">
              <h4 class="font-sans font-bold text-sm uppercase flex items-center gap-2">
                <span class="text-alert-red font-mono text-[10px]">0{a.order}</span>
                {a.title}
              </h4>
              <p class="font-mono text-[10px] text-gray-500 mt-1 pl-6 leading-tight truncate">
                {a.subtitle}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-rand-blue group-hover:underline decoration-2 underline-offset-4">
          Access Division Files <ArrowRight className="w-4 h-4" />
        </div>
      </a>

    </div>

  </div>
</div>
