---
import { ArrowRight, Database, Zap, MapPin, Calendar } from 'lucide-react';
import { APP_YEAR, CONFERENCE_DETAILS } from '../constants';
import { getCollection } from 'astro:content';

// Load articles from content collection
const allArticles = await getCollection('articles');

// Determine track from file path (2025-11-20 = Leadership, 2025-11-21 = Engineering)
const articlesWithTrack = allArticles.map((article: any) => {
  // Check which directory the symlink points to
  const isLeadership = article.id.includes('trust-role') ||
                       article.id.includes('context-memory') ||
                       article.id.includes('sdlc-evolution') ||
                       article.id.includes('roi-reality') ||
                       article.id.includes('proactive-vs') ||
                       article.id.includes('economics-ai');

  return {
    id: article.id,
    title: article.data.title,
    order: article.data.order,
    track: isLeadership ? 'LEADERSHIP' : 'ENGINEERING',
    subtitle: article.data.key_insights?.[0] || '',
    topics: article.data.topics || [],
  };
});

const leadershipArticles = articlesWithTrack
  .filter((a: any) => a.track === 'LEADERSHIP')
  .sort((a: any, b: any) => a.order - b.order)
  .slice(0, 4);

const engineeringArticles = articlesWithTrack
  .filter((a: any) => a.track === 'ENGINEERING')
  .sort((a: any, b: any) => a.order - b.order)
  .slice(0, 4);
---

<div class="w-full min-h-[calc(100vh-8rem)] max-w-7xl mx-auto bg-paper relative flex flex-col md:flex-row shadow-[10px_10px_0px_0px_rgba(0,0,0,0.1)] border border-void">

  <!-- Left Strip: Binding -->
  <div class="w-full md:w-20 bg-rand-blue flex md:flex-col justify-between items-center py-4 md:py-8 shrink-0 border-r border-void">
    <div class="text-white font-mono text-xs rotate-0 md:-rotate-90 whitespace-nowrap tracking-[0.3em]">
      SYSTEMS ANALYSIS DIV.
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 p-8 md:p-12 flex flex-col relative overflow-hidden">

    <!-- Background Network Graphic -->
    <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
      <svg width="400" height="400" viewBox="0 0 100 100">
        <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="0.5" />
        <line x1="100" y1="0" x2="0" y2="100" stroke="currentColor" stroke-width="0.5" />
        <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="0.5" />
        <rect x="20" y="20" width="60" height="60" fill="none" stroke="currentColor" stroke-width="0.5" />
      </svg>
    </div>

    <!-- Header Metadata -->
    <div class="flex flex-col md:flex-row justify-between items-start mb-12 border-b-2 border-void pb-6 gap-4">
      <div class="font-mono text-xs space-y-1">
        <p class="font-bold">PROJECT: {CONFERENCE_DETAILS.title}</p>
        <p>DOC. NO: RM-{APP_YEAR}-HZ</p>
        <div class="flex items-center gap-4 mt-2 text-gray-600">
          <span class="flex items-center gap-1"><MapPin className="w-3 h-3"/> {CONFERENCE_DETAILS.location}</span>
          <span class="flex items-center gap-1"><Calendar className="w-3 h-3"/> {CONFERENCE_DETAILS.date}</span>
        </div>
      </div>
      <div class="font-mono text-xs font-bold border border-void px-3 py-1 bg-white shadow-sm self-start md:self-auto">
        UNCLASSIFIED
      </div>
    </div>

    <!-- Title Block -->
    <div class="mb-12 relative z-10">
      <h1 class="text-6xl md:text-8xl font-sans font-black text-void leading-[0.85] tracking-tight mb-8">
        AI ENGINEERING<br/>
        CODE SUMMIT<br/>
        <span class="text-rand-blue">REPORT</span>
      </h1>

      <p class="font-sans font-medium text-lg max-w-2xl leading-snug border-l-4 border-alert-red pl-6 py-2 mb-4">
        {CONFERENCE_DETAILS.summary}
      </p>
    </div>

    <!-- Executive Summary Section -->
    <div class="space-y-6 mb-12 relative z-10">

      <!-- Abstract Box -->
      <div class="border-l-4 border-alert-red pl-6 py-3 bg-[#f8f8f6]">
        <p class="font-sans font-bold text-sm uppercase tracking-wide text-gray-500 mb-2">Abstract</p>
        <p class="font-sans text-base leading-relaxed">
          Two days of sessions from leaders at Anthropic, OpenAI, Meta, Netflix, Google DeepMind, and leading AI coding startups
          revealed a clear architecture: <strong>quality AI engineering requires human thinking at the center, environments as
          universal abstraction, specialized models through reinforcement learning, capability over scaffolding, and open data
          as infrastructure.</strong>
        </p>
      </div>

      <!-- State of the Field -->
      <div class="border border-void p-6 bg-white">
        <p class="font-sans font-bold text-sm uppercase tracking-wide text-gray-500 mb-3">State of the Field</p>
        <p class="font-sans text-sm leading-relaxed mb-4">
          The AI engineering landscape is transitioning from "pilot purgatory" to production reality. Organizations
          are discovering that model capability matters more than clever engineering tricks, that code quality determines
          AI productivity gains, and that the abstraction layer—not the model itself—is where competitive advantage lives.
        </p>
        <p class="font-sans text-sm leading-relaxed text-gray-600">
          <em>[PLACEHOLDER: This section will expand with detailed synthesis from the comprehensive analysis,
          one-pagers, and presentation materials—covering the architectural principles, implementation patterns,
          and strategic implications discovered across 25+ sessions.]</em>
        </p>
      </div>

    </div>

    <!-- Track Selection Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-void border border-void">

      <!-- Leadership Track -->
      <div class="bg-white p-8 hover:bg-[#f8f8f6] transition-colors relative">
        <div class="flex justify-between items-start mb-6">
          <h3 class="font-sans font-black text-3xl uppercase">Leadership</h3>
          <Database className="w-6 h-6 text-gray-400" />
        </div>

        <p class="font-mono text-xs mb-8 opacity-70 border-b border-dashed border-gray-400 pb-2">
          AI rewards excellence and punishes mediocrity. Trust grows from infrastructure, not promises.
        </p>

        <!-- Detailed Theme List -->
        <div class="space-y-6">
          {leadershipArticles.map((a: any) => (
            <a href={`/article/${a.id}`} class="block hover:bg-gray-50 -mx-2 px-2 py-1 transition-colors rounded">
              <h4 class="font-sans font-bold text-sm uppercase flex items-center gap-2 hover:text-rand-blue">
                <span class="text-alert-red font-mono text-[10px]">0{a.order}</span>
                {a.title}
              </h4>
              <p class="font-mono text-[10px] text-gray-500 mt-1 pl-6 leading-tight truncate">
                {a.subtitle}
              </p>
            </a>
          ))}
        </div>

        <a href="/track/leadership" class="mt-8 flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-rand-blue hover:underline decoration-2 underline-offset-4">
          Access Division Files <ArrowRight className="w-4 h-4" />
        </a>
      </div>

      <!-- Engineering Track -->
      <div class="bg-white p-8 hover:bg-[#f8f8f6] transition-colors relative">
        <div class="flex justify-between items-start mb-6">
          <h3 class="font-sans font-black text-3xl uppercase">Engineering</h3>
          <Zap className="w-6 h-6 text-gray-400" />
        </div>

        <p class="font-mono text-xs mb-8 opacity-70 border-b border-dashed border-gray-400 pb-2">
          The war on "slop" requires human thinking, environments as abstraction, and open data.
        </p>

        <!-- Detailed Theme List -->
        <div class="space-y-6">
          {engineeringArticles.map((a: any) => (
            <a href={`/article/${a.id}`} class="block hover:bg-gray-50 -mx-2 px-2 py-1 transition-colors rounded">
              <h4 class="font-sans font-bold text-sm uppercase flex items-center gap-2 hover:text-rand-blue">
                <span class="text-alert-red font-mono text-[10px]">0{a.order}</span>
                {a.title}
              </h4>
              <p class="font-mono text-[10px] text-gray-500 mt-1 pl-6 leading-tight truncate">
                {a.subtitle}
              </p>
            </a>
          ))}
        </div>

        <a href="/track/engineering" class="mt-8 flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-rand-blue hover:underline decoration-2 underline-offset-4">
          Access Division Files <ArrowRight className="w-4 h-4" />
        </a>
      </div>

    </div>

  </div>
</div>
