---
interface Props {
  type?: 'star' | 'arrow' | 'scribble' | 'circle' | 'underline';
  color?: string;
  class?: string;
}

const { type = 'star', color = 'var(--ink-blue)', class: className = '' } = Astro.props;

// Random seed for slight variations (simulated)
const randomRotation = Math.floor(Math.random() * 20) - 10;
const randomScale = 0.8 + Math.random() * 0.4;

---

<div class={`doodle-wrapper ${className}`} style={`transform: rotate(${randomRotation}deg) scale(${randomScale}); color: ${color};`}>
  <svg viewBox="0 0 100 100" class="w-full h-full overflow-visible" style="fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;">
    {type === 'star' && (
      <path d="M50 5 L63 35 L95 35 L70 55 L80 85 L50 65 L20 85 L30 55 L5 35 L37 35 Z" 
            style="stroke-dasharray: 300; stroke-dashoffset: 0;" />
    )}
    
    {type === 'arrow' && (
      <path d="M10 50 Q 30 40, 50 50 T 90 50 M 70 35 L 90 50 L 75 65" />
    )}

    {type === 'scribble' && (
      <path d="M10 50 Q 20 20, 30 50 T 50 50 T 70 50 T 90 50" />
    )}

    {type === 'circle' && (
      <path d="M50 10 A 40 40 0 1 0 50 90 A 40 40 0 1 0 50 10" 
            style="stroke-dasharray: 10 5;" />
    )}

    {type === 'underline' && (
      <path d="M5 50 Q 25 55, 50 50 T 95 55" />
    )}
  </svg>
</div>

<style>
  .doodle-wrapper {
    display: inline-block;
    width: 60px;
    height: 60px;
    pointer-events: none;
  }
</style>
