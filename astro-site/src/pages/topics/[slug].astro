---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getTopics, getSessionsByTopic } from '../../lib/content';

export function getStaticPaths() {
  const topics = getTopics();
  return topics.map((topic) => ({
    params: { slug: topic },
  }));
}

const { slug } = Astro.params;
const topic = slug as string;
const sessions = getSessionsByTopic(topic);
---

<Base title={`${topic} - AI Summit`}>
  <Header />
  
  <main class="max-w-4xl mx-auto px-6 py-24">
    <div class="mb-12 border-b border-[var(--ink-blue)] pb-6" style="border-bottom-style: dashed; border-bottom-width: 2px;">
      <h1 class="text-5xl font-bold font-title mb-4 transform -rotate-1">{topic}</h1>
      <p class="text-xl font-handwriting text-[var(--ink)]">
        {sessions.length} session{sessions.length !== 1 ? 's' : ''} exploring this theme
      </p>
    </div>

    <div class="grid gap-8">
      {sessions.map((session) => (
        <a href={`/sessions/${session.slug}/`} class="block group">
          <article class="sketch-card">
            <div class="flex justify-between items-start mb-3">
              <span class="sketch-tag transform -rotate-2">
                {session.track || 'General'}
              </span>
              <span class="text-sm font-mono text-[var(--ink-blue)] font-bold">
                {session.frontmatter.time}
              </span>
            </div>
            
            <h2 class="text-2xl font-bold mb-2 font-handwriting group-hover:text-[var(--ink-blue)]">
              {session.frontmatter.title}
            </h2>
            
            <div class="flex items-center gap-2 text-[var(--ink)] mb-4 font-handwriting text-lg">
              <span class="font-bold">{session.frontmatter.speaker}</span>
              {session.frontmatter.company && (
                <>
                  <span>•</span>
                  <span>{session.frontmatter.company}</span>
                </>
              )}
            </div>

            <div class="flex flex-wrap gap-2 mt-3">
              {session.frontmatter.topics?.map((t) => (
                <span class="sketch-tag text-xs transform rotate-1">
                  {t}
                </span>
              ))}
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>
</Base>
