---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Doodle from '../../components/Doodle.astro';
import { getTopics, getSessionsByTopic } from '../../lib/content';

const topics = getTopics();
---

<Base title="Themes - AI Summit">
  <Header />
  
  <main class="max-w-4xl mx-auto px-6 py-24 relative">
    <!-- Header Doodle -->
    <div class="absolute top-20 right-0 hidden md:block">
        <Doodle type="scribble" color="var(--ink-blue)" class="transform rotate-12 scale-125" />
    </div>

    <div class="mb-12 border-b border-[var(--ink-blue)] pb-6 relative" style="border-bottom-style: dashed; border-bottom-width: 3px;">
      <h1 class="text-6xl font-bold font-title mb-4 transform -rotate-1 relative inline-block">
        Themes & Topics
        <div class="absolute -top-6 -right-8">
            <Doodle type="star" color="var(--highlight-yellow)" class="w-12 h-12 opacity-80" />
        </div>
      </h1>
      <p class="text-2xl font-handwriting text-[var(--ink)] mt-2">
        Explore the summit through key themes and emerging patterns
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {topics.map((topic, idx) => {
        const count = getSessionsByTopic(topic).length;
        const colors = ['yellow', 'pink', 'blue', 'green', 'orange'];
        const colorClass = colors[idx % colors.length];
        const rotation = (idx % 3 === 0) ? 'rotate-2' : (idx % 3 === 1) ? '-rotate-1' : 'rotate-1';
        
        return (
          <a href={`/topics/${encodeURIComponent(topic)}/`} class="block group relative">
            {/* Random doodles on some cards */}
            {idx % 4 === 0 && (
                <div class="absolute -bottom-4 -left-2 z-20 transform -rotate-12">
                    <Doodle type="underline" color="var(--ink-blue)" class="w-16 opacity-60" />
                </div>
            )}

            <article class={`sketch-card h-full flex flex-col justify-between transform ${rotation} hover:-translate-y-2 transition-all`}
                     style={`background: var(--highlight-${colorClass});`}>
              <h2 class="text-3xl font-bold font-title mb-3 group-hover:text-[var(--ink-blue)] transform -rotate-1">
                {topic}
              </h2>
              <span class={`sketch-tag self-end transform rotate-2`}>
                {count} session{count !== 1 ? 's' : ''}
              </span>
            </article>
          </a>
        );
      })}
    </div>
  </main>
</Base>
