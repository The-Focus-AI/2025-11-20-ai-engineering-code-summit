---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getSessions, type Session } from '../../lib/content';

export function getStaticPaths() {
  return [
    { params: { date: '2025-11-20' } },
    { params: { date: '2025-11-21' } },
  ];
}

const { date } = Astro.params;
const track = date === '2025-11-20' ? 'Leadership' : 'Engineering';
const sessions = getSessions().filter((s: Session) => s.date === date);
---

<Base title={`${track} Track - AI Summit`}>
  <Header />
  
  <main class="max-w-4xl mx-auto px-6 py-24">
    <div class="mb-12 border-b border-[var(--ink-blue)] pb-6" style="border-bottom-style: dashed; border-bottom-width: 2px;">
      <h1 class="text-5xl font-bold font-title mb-4 transform -rotate-1">{track} Track</h1>
      <p class="text-xl font-handwriting text-[var(--ink)]">
        {date === '2025-11-20' ? 'Day 1' : 'Day 2'} • {sessions.length} sessions
      </p>
    </div>

    <div class="grid gap-8">
      {sessions.map((session: Session) => (
        <a href={`/sessions/${session.slug}/`} class="block group">
          <article class="sketch-card">
            <div class="flex justify-between items-start mb-3">
              <span class="sketch-tag transform -rotate-1">
                {session.frontmatter.time}
              </span>
            </div>
            
            <h2 class="text-2xl font-bold mb-2 font-handwriting group-hover:text-[var(--ink-blue)]">
              {session.frontmatter.title}
            </h2>
            
            <div class="flex items-center gap-2 text-[var(--ink)] mb-4 font-handwriting">
              <span class="font-bold">{session.frontmatter.speaker}</span>
              {session.frontmatter.company && (
                <>
                  <span>•</span>
                  <span>{session.frontmatter.company}</span>
                </>
              )}
            </div>

            <div class="flex flex-wrap gap-2">
              {session.frontmatter.topics?.map((t) => (
                <span class="sketch-tag text-xs transform rotate-1">
                  {t}
                </span>
              ))}
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>
</Base>
