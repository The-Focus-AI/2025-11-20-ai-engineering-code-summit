---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getSessions, type Session } from '../../lib/content';
import { marked } from 'marked';

export function getStaticPaths() {
  const sessions = getSessions();
  return sessions.map((session: Session) => ({
    params: { slug: session.slug },
    props: { session },
  }));
}

const { session } = Astro.props as { session: Session };
const contentHtml = marked(session.content);
---

<Base title={`${session.frontmatter.title} - AI Summit`}>
  <Header />
  
  <main class="max-w-3xl mx-auto px-6 py-24">
    <article class="sketch-card transform rotate-1">
      <div class="mb-8 border-b border-[var(--ink-blue)] pb-8" style="border-bottom-style: dashed; border-bottom-width: 2px;">
        <div class="flex items-center gap-3 mb-4">
          <span class="sketch-tag transform -rotate-2">
            {session.track}
          </span>
          <span class="text-sm font-mono text-[var(--ink-blue)] font-bold">
            {session.frontmatter.time}
          </span>
        </div>

        <h1 class="text-4xl font-bold font-title mb-4 leading-tight transform -rotate-1">
          {session.frontmatter.title}
        </h1>

        <div class="flex items-center gap-2 text-xl text-[var(--ink)] font-handwriting mb-6">
          <span class="font-bold">{session.frontmatter.speaker}</span>
          {session.frontmatter.company && (
            <>
              <span>•</span>
              <span>{session.frontmatter.company}</span>
            </>
          )}
        </div>

        <div class="flex flex-wrap gap-2">
          {session.frontmatter.topics?.map((t) => (
            <a href={`/topics/${encodeURIComponent(t)}/`} class="sketch-tag hover:scale-110 transition-transform">
              {t}
            </a>
          ))}
        </div>
      </div>

      <div class="prose prose-lg max-w-none font-handwriting">
        <div set:html={contentHtml} />
      </div>
    </article>
  </main>
</Base>

<style>
  .prose {
    font-family: var(--font-body);
    line-height: 1.8;
    font-size: 1.2rem;
  }
  
  .prose :global(h2) {
    font-family: var(--font-title);
    font-size: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--ink-blue);
    transform: rotate(-1deg);
  }

  .prose :global(h3) {
    font-family: var(--font-title);
    font-size: 1.5rem;
    margin-top: 2rem;
    font-weight: bold;
  }

  .prose :global(ul), .prose :global(ol) {
    margin-left: 1.5rem;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--ink-blue);
    padding-left: 1.5rem;
    font-style: italic;
    background: rgba(255, 249, 196, 0.3); /* Highlight color low opacity */
    padding: 1rem;
    margin: 2rem 0;
    border-radius: 0 4px 4px 0;
    transform: rotate(1deg);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    background: #f5f5f5;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
    border: 1px dashed #ccc;
  }
</style>
