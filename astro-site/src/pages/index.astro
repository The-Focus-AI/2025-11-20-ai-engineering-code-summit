---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero';
import Doodle from '../components/Doodle.astro';
import { getTopics, getSessionsByTopic } from '../lib/content';

const topics = getTopics();
---

<Base title="AI Engineering Code Summit 2025">
  <Header />
  
  <Hero client:load />

  <main class="max-w-6xl mx-auto px-6 pb-20 relative">
    <!-- Random Doodles -->
    <div class="absolute top-0 left-10 hidden lg:block">
      <Doodle type="star" color="var(--highlight-pink)" class="opacity-80" />
    </div>
    <div class="absolute bottom-20 right-10 hidden lg:block">
      <Doodle type="scribble" color="var(--ink-blue)" class="opacity-60" />
    </div>

    <section class="mt-12 relative">
      <div class="flex items-center gap-4 mb-12 relative">
        <div class="absolute -left-12 -top-8 hidden md:block">
            <Doodle type="arrow" color="var(--ink)" class="transform rotate-45" />
        </div>
        <h2 class="text-6xl font-bold font-title tracking-wide text-[var(--ink-blue)] transform -rotate-2">Explore by Theme</h2>
        <div class="h-3 bg-[var(--ink-blue)] flex-grow opacity-30 rounded-full transform -rotate-1" style="border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 px-4">
        {topics.map((topic, idx) => {
          const count = getSessionsByTopic(topic).length;
          const colors = ['yellow', 'pink', 'blue', 'green', 'orange'];
          const colorClass = colors[idx % colors.length];
          const rotation = (idx % 3 === 0) ? 'rotate-2' : (idx % 3 === 1) ? '-rotate-1' : 'rotate-1';
          
          return (
            <a href={`/topics/${encodeURIComponent(topic)}/`} class="block group relative">
              {/* Occasional doodle on cards */}
              {idx % 3 === 0 && (
                <div class="absolute -top-4 -right-4 z-20 transform rotate-12">
                    <Doodle type="star" color="var(--ink)" class="w-8 h-8 opacity-50" />
                </div>
              )}
              
              <article class={`sketch-card transform ${rotation} hover:-translate-y-2 transition-all`} 
                       style={`background: var(--highlight-${colorClass});`}>
                <h3 class="text-3xl font-bold font-title mb-3 group-hover:text-[var(--ink-blue)] transform -rotate-1">
                  {topic}
                </h3>
                <span class={`sketch-tag transform rotate-2`}>
                  {count} session{count !== 1 ? 's' : ''}
                </span>
              </article>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Base>
